rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isCurrentServerTimestamp(value) {
      return value is timestamp && value == request.time;
    }

    function ownsExistingQuota() {
      return signedIn()
        && resource != null
        && resource.data.bound_uid is string
        && resource.data.bound_uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read, create, update, delete: if owns(uid);
    }

    // The decryption/recovery key is never stored in Firestore.
    match /users/{uid}/private/apiKeys {
      allow get: if owns(uid);
      allow list, delete: if false;
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'version', 'revision', 'nonce', 'ciphertext', 'mac'
        ])
        && request.resource.data.version == 1
        && request.resource.data.revision is int
        && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1)
        && request.resource.data.nonce is string
        && request.resource.data.nonce.size() == 16
        && request.resource.data.mac is string
        && request.resource.data.mac.size() == 24
        && request.resource.data.ciphertext is string
        && request.resource.data.ciphertext.size() > 0
        && request.resource.data.ciphertext.size() <= 4096;
    }

    match /projects/{uid}/user_projects/{projectId} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid == uid
        && request.resource.data.id is string
        && request.resource.data.id == projectId;
    }

    match /device_quotas/{fingerprint} {
      // A transaction must be able to observe that its own random
      // installation fingerprint is unused before creating it. Existing quota
      // documents, however, contain account data and are owner-readable only.
      allow get: if signedIn()
        && (resource == null || ownsExistingQuota());
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'runs_used',
          'bound_uid',
          'created_at',
          'last_used_at'
        ])
        && request.resource.data.bound_uid == request.auth.uid
        && request.resource.data.runs_used is int
        && request.resource.data.runs_used >= 1
        && request.resource.data.runs_used <= 3
        && isCurrentServerTimestamp(request.resource.data.created_at)
        && isCurrentServerTimestamp(request.resource.data.last_used_at);

      allow update: if ownsExistingQuota()
        && request.resource.data.keys().hasOnly([
          'runs_used',
          'bound_uid',
          'created_at',
          'last_used_at'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'runs_used',
          'last_used_at'
        ])
        && request.resource.data.bound_uid is string
        && request.resource.data.bound_uid == request.auth.uid
        && request.resource.data.bound_uid == resource.data.bound_uid
        && resource.data.created_at is timestamp
        && request.resource.data.created_at == resource.data.created_at
        && resource.data.runs_used is int
        && request.resource.data.runs_used is int
        && request.resource.data.runs_used > resource.data.runs_used
        && request.resource.data.runs_used <= 3
        && isCurrentServerTimestamp(request.resource.data.last_used_at);

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
